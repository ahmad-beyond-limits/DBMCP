# ==============================================================================
# Policy Enforced AI Workspace - Environment Configuration
# ==============================================================================
# This file defines all environment variables required by the application.
# Duplicate this file as .env and populate with actual secrets in production.
# The application will fail safely at startup if required secrets are missing.
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=Policy Enforced AI Workspace
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Backend Security
SECRET_KEY=change-this-to-a-very-long-cryptographically-secure-random-secret-key-32b
JWT_SECRET_KEY=change-this-to-another-very-long-cryptographically-secure-jwt-secret-32b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Database (Supabase PostgreSQL / Async compatible connection string)
# Example: postgresql+asyncpg://postgres:your-password@db.xxx.supabase.co:5432/postgres
# For local dev / testing fallback: sqlite+aiosqlite:///./workspace.db
DATABASE_URL=sqlite+aiosqlite:///./workspace.db

# Supabase Storage & Services
# Leave empty for local fallback storage during offline development/testing
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=workspace-files

# Workspace and MCP Security
WORKSPACE_HASH_SECRET=change-this-to-a-secure-secret-for-workspace-salting-32b
MCP_TOKEN_SECRET=change-this-to-a-secure-secret-for-mcp-tokens-32b
MCP_TOKEN_EXPIRE_DAYS=30
MCP_SESSION_SECRET=change-this-to-a-secure-secret-for-mcp-sessions-32b

# Data Encryption (Optional symmetric key for data at rest, 32 bytes URL-safe base64)
DATA_ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3QtZW5jcnlwdGlvbi1rZXktMzJieXRlcw==

# Optional AI Services (for future extensions)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO

# File Limits
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_WORKSPACE=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server Port (Render sets this dynamically via PORT)
PORT=8000

# ==============================================================================
# DBMCP - SINGLE UNIFIED MASTER ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# 1. APPLICATION SETTINGS
APP_ENV=development
APP_NAME="Policy Enforced AI Workspace"
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# 2. BACKEND AUTHENTICATION & SECURITY KEYS
SECRET_KEY=change-me-to-a-secure-random-32-byte-secret-key
JWT_SECRET_KEY=change-me-to-a-secure-random-32-byte-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# 3. SUPABASE POSTGRESQL DATABASE
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# 4. SUPABASE STORAGE & API SERVICES
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=workspace-files

# 5. WORKSPACE TENANCY & MCP CRYPTOGRAPHIC SECRETS
WORKSPACE_HASH_SECRET=change-me-to-a-secure-random-32-byte-workspace-secret
MCP_TOKEN_SECRET=change-me-to-a-secure-random-32-byte-mcp-token-secret
MCP_TOKEN_EXPIRE_DAYS=30
MCP_SESSION_SECRET=change-me-to-a-secure-random-32-byte-session-secret

# 6. AT-REST DATA ENCRYPTION (AES-256-GCM)
DATA_ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3QtZW5jcnlwdGlvbi1rZXktMzJieXRlcw==

# 7. LOGGING & RESOURCE LIMITS
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=50
MAX_FILES_PER_WORKSPACE=100

# 8. SERVER PORT & CORS
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,https://dbmcp.onrender.com,https://poais-mcp.vercel.app

# 9. FRONTEND & VERCEL CONFIGURATION
NEXT_PUBLIC_API_URL=https://dbmcp.onrender.com
NEXT_PUBLIC_APP_NAME="DBMCP Gateway"
